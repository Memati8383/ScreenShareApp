<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skeletonContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:visibility="gone">

    <!-- Center content only -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieLoading"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <!-- Skeleton icon (hidden when Lottie is used) -->
        <View
            android:id="@+id/skeletonIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_skeleton_circle"
            android:visibility="gone" />

        <!-- Skeleton title -->
        <View
            android:id="@+id/skeletonTitle"
            android:layout_width="180dp"
            android:layout_height="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_skeleton" />

        <!-- Skeleton subtitle -->
        <View
            android:id="@+id/skeletonSubtitle"
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_skeleton" />

        <!-- Skeleton status text -->
        <View
            android:id="@+id/skeletonStatus"
            android:layout_width="100dp"
            android:layout_height="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_skeleton" />

        <!-- Skeleton progress bar (hidden when Lottie is used) -->
        <ProgressBar
            android:id="@+id/skeletonProgress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <!-- Skeleton hint text -->
        <TextView
            android:id="@+id/skeletonHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/status_connecting"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
