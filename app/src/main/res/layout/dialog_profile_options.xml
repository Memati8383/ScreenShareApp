<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_profile"
    android:padding="24dp">

    <!-- Başlık -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/profile_change_profile"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Galeri Seçeneği -->
    <LinearLayout
        android:id="@+id/optionGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_dialog_option"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_image"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@string/profile_photo_gallery" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/profile_photo_gallery"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Kamera Seçeneği -->
    <LinearLayout
        android:id="@+id/optionCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_dialog_option"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_camera"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@string/profile_photo_camera" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/profile_photo_camera"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Avatar Seçeneği -->
    <LinearLayout
        android:id="@+id/optionAvatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_dialog_option"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_avatar"
            android:tint="?attr/colorPrimary"
            android:contentDescription="@string/profile_avatar_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/profile_avatar_title"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Kaldır Seçeneği (Opsiyonel) -->
    <LinearLayout
        android:id="@+id/optionRemove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_dialog_option"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/error"
            android:contentDescription="@string/profile_photo_remove" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/profile_photo_remove"
            android:textSize="16sp"
            android:textColor="@color/error"
            android:layout_marginStart="16dp" />

    </LinearLayout>

</LinearLayout>
