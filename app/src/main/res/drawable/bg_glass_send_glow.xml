<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow -->
    <item
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="180"
                android:startColor="#660066FF"
                android:endColor="#000066FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Buton -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF0066FF"
                android:endColor="#FF00D4FF"
                android:angle="135" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
