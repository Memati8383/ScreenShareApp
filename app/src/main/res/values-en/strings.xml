    <string name="troubleshoot_network_desc">Check your internet connection.\nTry connecting via WiFi or mobile data.\nMake sure the server address is correct.</string>
    <string name="troubleshoot_lag_title">Lag Issue</string>
    <string name="troubleshoot_lag_desc">Try connecting to a WiFi network.\nClose unnecessary background apps.\nTry lowering the resolution (480p/720p).</string>
