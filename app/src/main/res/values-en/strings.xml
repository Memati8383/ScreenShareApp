    <!-- Help -->
    <string name="help_title">Help</string>
    <string name="help_how_title">How Does It Work?</string>
    <string name="help_how_desc">ScreenShare uses WebRTC technology to share your screen between two devices.\n\n1. Enter the same room name on both devices\n2. Select \'Broadcast\' on one device and \'Watch\' on the other\n3. The connection will be established automatically</string>
    <string name="help_start_title">How to Start a Broadcast?</string>
    <string name="help_start_desc">1. Enter the room name on the home screen\n2. Tap the \'Broadcast (Host)\' option\n3. Press the \'Start\' button\n4. Confirm the screen sharing permission\n5. Wait for the other device to connect</string>
    <string name="help_watch_title">How to Watch a Broadcast?</string>
    <string name="help_watch_desc">1. Enter the same room name on the home screen\n2. Tap the \'Watch (Client)\' option\n3. Press the \'Connect\' button\n4. Wait for the broadcaster to connect\n5. The broadcast will start automatically</string>
    <string name="help_troubleshoot_title">Troubleshooting</string>
    <string name="help_troubleshoot_desc">• Connection issue: Check your internet connection\n• Latency: Try connecting to a WiFi network\n• Screen share not starting: Check permissions\n• App crashed: Restart the app</string>
    <string name="help_faq_title">FAQ</string>
    <string name="help_faq_desc">Q: How many devices can connect at once?\nA: Currently 2 devices (1 broadcaster + 1 viewer)\n\nQ: Is internet connection required?\nA: Yes, both devices need to be connected to the internet\n\nQ: Is it free?\nA: Yes, the app is completely free</string>
    <string name="help_privacy_title">Privacy &amp; Security</string>
    <string name="help_privacy_desc">ScreenShare takes the following measures to protect your privacy:\n\n🔒 Encryption: All WebRTC connections are encrypted with DTLS\n\n🗑️ Data Storage: Image data is not stored on servers, transmitted directly between devices\n\n🌐 Server Role: Server only helps with connection setup, cannot access screen content\n\n📱 Permissions: Screen sharing permission is only requested during broadcasting\n\n🔐 Room Security: Each room is protected with a unique name, unauthorized access is prevented\n\nNote: No usage statistics are collected.</string>
