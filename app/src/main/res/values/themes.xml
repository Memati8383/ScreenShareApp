<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScreenShare" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/dark_accent</item>
        <item name="colorPrimaryVariant">@color/dark_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/dark_accent</item>
        <item name="colorSecondaryVariant">@color/dark_accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/dark_bg_card</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>
        <item name="colorSurfaceVariant">@color/dark_bg_input</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_container_high</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface_container_low</item>
        <item name="colorOutline">@color/dark_border</item>
        <item name="colorOutlineVariant">@color/dark_border</item>
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:textColorHint">@color/dark_text_hint</item>
        <item name="android:editTextColor">@color/dark_text_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="ShapeAppearanceOverlay.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.ScreenShare.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="colorAccent">@color/dark_accent</item>
        <item name="colorPrimary">@color/dark_accent</item>
        <item name="colorSurface">@color/dark_bg_card</item>
    </style>

    <style name="Theme.ScreenShare.PreferenceDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:textColorHint">@color/dark_text_hint</item>
        <item name="colorAccent">@color/dark_accent</item>
        <item name="colorPrimary">@color/dark_accent</item>
        <item name="colorSurface">@color/dark_bg_card</item>
        <item name="buttonBarPositiveButtonStyle">@style/GlassDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/GlassDialogButton</item>
    </style>

    <style name="GlassDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dark_accent</item>
    </style>

    <!-- Premium Splash Screen Theme -->
    <style name="Theme.ScreenShare.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
