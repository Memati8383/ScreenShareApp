    <string name="help_device_version">Sürüm</string>
    <string name="help_device_android">Android</string>
    <string name="troubleshoot_network_title">Bağlantı Sorunu</string>
    <string name="troubleshoot_network_desc">İnternet bağlantınızı kontrol edin.\nWiFi veya mobil veri ile tekrar deneyin.\nSunucu adresinin doğru olduğundan emin olun.</string>
    <string name="troubleshoot_lag_title">Gecikme Sorunu</string>
    <string name="troubleshoot_lag_desc">WiFi ağına bağlanmayı deneyin.\nArka plandaki gereksiz uygulamaları kapatın.\nÇözünürüğü düşürmeyi deneyin (480p/720p).</string>
    <string name="troubleshoot_screen_title">Ekran Paylaşımı Başlamadı</string>
    <string name="troubleshoot_screen_desc">Ekran paylaşımı iznini kontrol edin.\nUygulamayı yeniden başlatın.\nİzinler ayarlarından uygulamaya izin verin.</string>
    <string name="troubleshoot_crash_title">Uygulama Çöktü</string>
    <string name="troubleshoot_crash_desc">Uygulamayı tamamen kapatıp yeniden açın.\nCihazınızı yeniden başlatın.\nSorun devam ederse uygulamayı güncelleyin.</string>

